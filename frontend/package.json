{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:property": "node --test tests/property/*.test.mjs",
    "test:sanity": "node --test tests/sanity/*.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:fuzz": "node --test tests/fuzz/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:model": "node --test tests/model/*.test.mjs",
    "test:all": "node --test tests/sanity/*.test.mjs tests/unit/*.test.mjs tests/fuzz/*.test.mjs tests/property/*.test.mjs tests/integration/*.test.mjs tests/model/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/sanity/*.test.mjs tests/unit/*.test.mjs tests/fuzz/*.test.mjs tests/property/*.test.mjs tests/integration/*.test.mjs tests/model/*.test.mjs"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
