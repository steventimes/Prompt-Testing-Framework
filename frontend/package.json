{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:property": "node --test --test-name-pattern=\"^property:\" tests/verification/mockMath.verification.test.mjs",
    "test:sanity": "node --test --test-name-pattern=\"^smoke:\" tests/verification/mockMath.verification.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:fuzz": "node --test --test-name-pattern=\"^fuzz:\" tests/verification/mockMath.verification.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:model": "node --test --test-name-pattern=\"^model-check:\" tests/verification/mockMath.verification.test.mjs",
    "test:all": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs tests/verification/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/*.test.mjs tests/integration/*.test.mjs tests/verification/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  }
}
