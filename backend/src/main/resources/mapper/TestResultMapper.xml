<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.promptframework.mapper.TestResultMapper">

    <resultMap id="TestResultResultMap" type="TestResult">
        <id property="id" column="id"/>
        <result property="testRunId" column="test_run_id"/>
        <result property="caseName" column="case_name"/>
        <result property="inputVariables" column="input_variables"
                jdbcType="OTHER" typeHandler="com.promptframework.config.JsonMapTypeHandler"/>
        <result property="status" column="status"/>
        <result property="errorCode" column="error_code"/>
        <result property="errorMessage" column="error_message"/>
        <result property="aiResponse" column="ai_response"/>
        <result property="responseTimeMs" column="response_time_ms"/>
        <result property="tokenCount" column="token_count"/>
        <result property="costUsd" column="cost_usd"/>
        <result property="qualityScore" column="quality_score"/>
        <result property="assertionPassed" column="assertion_passed"/>
        <result property="assertionResults" column="assertion_results"
                jdbcType="OTHER" typeHandler="com.promptframework.config.AssertionResultListTypeHandler"/>
        <result property="privacyRiskScore" column="privacy_risk_score"/>
        <result property="privacyFlags" column="privacy_flags"
                jdbcType="OTHER" typeHandler="com.promptframework.config.JsonStringListTypeHandler"/>
        <result property="mcpCalls" column="mcp_calls"
                jdbcType="OTHER" typeHandler="com.promptframework.config.McpToolCallListTypeHandler"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="TestResult" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO test_results (
            test_run_id, case_name, input_variables, status, error_code, error_message,
            ai_response, response_time_ms, token_count, cost_usd, quality_score,
            assertion_passed, assertion_results,
            privacy_risk_score, privacy_flags, mcp_calls, created_at
        )
        VALUES (
            #{testRunId},
            #{caseName},
            #{inputVariables, jdbcType=OTHER, typeHandler=com.promptframework.config.JsonMapTypeHandler},
            #{status},
            #{errorCode},
            #{errorMessage},
            #{aiResponse},
            #{responseTimeMs},
            #{tokenCount},
            #{costUsd},
            #{qualityScore},
            #{assertionPassed},
            #{assertionResults, jdbcType=OTHER, typeHandler=com.promptframework.config.AssertionResultListTypeHandler},
            #{privacyRiskScore},
            #{privacyFlags, jdbcType=OTHER, typeHandler=com.promptframework.config.JsonStringListTypeHandler},
            #{mcpCalls, jdbcType=OTHER, typeHandler=com.promptframework.config.McpToolCallListTypeHandler},
            NOW()
        )
    </insert>

    <select id="findById" resultMap="TestResultResultMap">
        SELECT * FROM test_results WHERE id = #{id}
    </select>

    <select id="findByTestRunId" resultMap="TestResultResultMap">
        SELECT * FROM test_results 
        WHERE test_run_id = #{testRunId}
        ORDER BY created_at ASC, id ASC
    </select>

</mapper>
